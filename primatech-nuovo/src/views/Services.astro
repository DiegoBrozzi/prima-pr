---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactBand from '../components/ContactBand.astro';
import Icon from '../components/Icon.astro';
import { alternates, url, useT, type Lang } from '../i18n';
import { breadcrumbLd } from '../lib/seo';
import heroImg from '../assets/img/formazione.jpg';
import posterSrc from '../assets/img/bkg.jpg';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const s = t.servicesPage;
const poster = await getImage({ src: posterSrc, width: 1280, format: 'webp' });
const crumbs = [
  { label: t.nav.home, href: url('home', lang) },
  { label: t.nav.services, href: url('services', lang) },
];
const contact = url('contact', lang);
const ctaHref: Record<string, string> = {
  assistenza: `${contact}?argomento=service`,
  formazione: `${contact}?argomento=service`,
  sviluppo: `${contact}?argomento=info`,
  'post-vendita': url('parts', lang),
};
---

<Base
  lang={lang}
  title={t.meta.services.title}
  description={t.meta.services.description}
  alternates={alternates((l) => url('services', l))}
  current="services"
  jsonLd={[breadcrumbLd(crumbs)]}
>
  <PageHero lang={lang} eyebrow={s.eyebrow} title={s.title} lead={s.lead} crumbs={crumbs} image={heroImg} />

  <section class="section" aria-labelledby="svc-title">
    <div class="wrap">
      <h2 id="svc-title" class="sr-only">{s.eyebrow}</h2>
      <ul class="svc-cards" data-stagger>
        {
          s.items.map((it, i) => (
            <li id={it.id} data-reveal>
              <span class="idx">0{i + 1}</span>
              <h3>{it.title}</h3>
              <p>{it.text}</p>
              <a class="link-arrow" href={ctaHref[it.id]}>
                {it.cta} <Icon name="arrow" class="arrow" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--steel" aria-labelledby="process-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">{s.eyebrow}</p>
          <h2 id="process-title" data-reveal>{s.processTitle}</h2>
        </div>
      </div>
      <ol class="steps" data-stagger>
        {
          s.process.map((p) => (
            <li data-reveal>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section dark" aria-label={s.videoLabel}>
    <div class="wrap">
      <figure class="video-frame cropmarks" data-reveal="cut">
        <video controls muted playsinline preload="none" poster={poster.src} aria-label={s.videoLabel}>
          <source src="/video/servizi-mettifoglio.mp4" type="video/mp4" />
        </video>
      </figure>
    </div>
  </section>

  <ContactBand lang={lang} />
</Base>
